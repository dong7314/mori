          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "소셜 제공자의 서버 콜백",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/{provider}/login": {
      "get": {
        "operationId": "login_v1_auth__provider__login_get",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Provider"
            }
          },
          {
            "in": "query",
            "name": "return_url",
            "required": true,
            "schema": {
              "maxLength": 2048,
              "title": "Return Url",
              "type": "string"
            }
          },
          {
            "description": "클라이언트 verifier의 S256 값",
            "in": "query",
            "name": "code_challenge",
            "required": true,
            "schema": {
              "description": "클라이언트 verifier의 S256 값",
              "pattern": "^[A-Za-z0-9_-]{43}$",
              "title": "Code Challenge",
              "type": "string"
            }
          },
          {
            "description": "클라이언트에서 생성하고 복귀 시 확인할 난수",
            "in": "query",
            "name": "client_state",
            "required": true,
            "schema": {
              "description": "클라이언트에서 생성하고 복귀 시 확인할 난수",
              "pattern": "^[A-Za-z0-9_-]{32,128}$",
              "title": "Client State",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "시스템 브라우저에서 소셜 로그인 시작",
        "tags": [
          "auth"
        ]
      }
    },
