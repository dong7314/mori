{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ExchangeRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "title": "Code",
            "type": "string"
          },
          "code_verifier": {
            "pattern": "^[A-Za-z0-9._~-]{43,128}$",
            "title": "Code Verifier",
            "type": "string"
          }
        },
        "required": [
          "code",
          "code_verifier"
        ],
        "title": "ExchangeRequest",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/Provider"
            },
            "title": "Providers",
            "type": "array"
          }
        },
        "required": [
          "id",
          "display_name",
          "providers"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "ParkingCreate": {
        "additionalProperties": false,
        "examples": [
          {
            "floor": "B2",
            "spot": "C36",
            "zone": "C"
          }
        ],
        "properties": {
          "floor": {
            "anyOf": [
              {
                "maxLength": 32,
                "minLength": 1,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Floor"
          },
          "spot": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spot"
          },
          "zone": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone"
          }
        },
        "title": "ParkingCreate",
        "type": "object"
      },
      "ParkingRead": {
        "properties": {
          "floor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Floor"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "recorded_at": {
            "format": "date-time",
            "title": "Recorded At",
            "type": "string"
          },
          "spot": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spot"
          },
          "zone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone"
          }
        },
        "required": [
          "id",
          "floor",
          "zone",
          "spot",
          "recorded_at"
        ],
        "title": "ParkingRead",
        "type": "object"
      },
      "Provider": {
        "enum": [
          "naver",
          "kakao"
        ],
        "title": "Provider",
        "type": "string"
      },
      "ProviderAvailability": {
        "properties": {
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          }
        },
        "required": [
          "provider",
          "enabled"
        ],
        "title": "ProviderAvailability",
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "format": "password",
            "title": "Refresh Token",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_expires_in": {
            "title": "Refresh Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "const": "Bearer",
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in",
          "refresh_token",
          "refresh_expires_in"
        ],
        "title": "TokenResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "네이버·카카오 로그인 후 발급한 Mori 액세스 토큰",
        "scheme": "bearer",
        "type": "http"
      }
    }
