# Local development only. The production connection string belongs in a Secret.
MORI_DATABASE_URL=postgresql+psycopg://mori:mori-local-only@127.0.0.1:55432/mori
MORI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# The provider consoles must register the API callback URLs listed in docs/social-login.md.
MORI_AUTH_PUBLIC_BASE_URL=http://localhost:8000
MORI_AUTH_RETURN_URLS=["http://localhost:5173/auth/callback"]
# false is accepted only when the public API host is localhost/loopback.
MORI_AUTH_COOKIE_SECURE=false
MORI_AUTH_ACCESS_TOKEN_SECONDS=900
MORI_AUTH_SESSION_DAYS=30
MORI_NAVER_CLIENT_ID=
MORI_NAVER_CLIENT_SECRET=
MORI_KAKAO_CLIENT_ID=
MORI_KAKAO_CLIENT_SECRET=

# Hermes connection for authenticated chat. Shared home is single-owner only.
# Use an internal HTTP(S) origin without /v1; never expose the Hermes key to clients.
MORI_HERMES_BASE_URL=
MORI_HERMES_API_KEY=
# UUID from the test account's authenticated GET /v1/me response.
MORI_HERMES_TEST_USER_ID=
MORI_HERMES_TIMEOUT_SECONDS=300

# Authenticated conversations / SSE; see docs/chat.md. Shared home is single-owner only.
MORI_CHAT_ENABLED=false
MORI_HERMES_STARTUP_TIMEOUT_SECONDS=90
# JSON mapping user UUID -> {base_url, api_key}. Keep in server Secret, never Git.
# Private runtimes must already exist with separate homes/credentials; Pro users only.
MORI_CHAT_PRIVATE_RUNTIMES={}

# Separate worker: mori worker (or mori worker --once).
MORI_AUTOMATION_ENABLED=false
MORI_AUTOMATION_POLL_SECONDS=15
MORI_AUTOMATION_LEASE_SECONDS=900
MORI_AUTOMATION_MAX_ATTEMPTS=3
MORI_SEARXNG_BASE_URL=
# See docs/poc-backend-0.8.md for the configured gateway's quote/candles JSON.
MORI_MARKET_DATA_BASE_URL=
MORI_MARKET_DATA_API_KEY=
MORI_MARKET_DATA_PROVIDER=configured
MORI_PUSH_ENABLED=false
MORI_VAPID_PUBLIC_KEY=
MORI_VAPID_PRIVATE_KEY=
MORI_VAPID_SUBJECT=
MORI_PUSH_ALLOWED_HOSTS=["fcm.googleapis.com","updates.push.services.mozilla.com","web.push.apple.com"]
MORI_PUSH_TIMEOUT_SECONDS=10
MORI_PUSH_MAX_ATTEMPTS=3
MORI_PUSH_LEASE_SECONDS=60


# Backend 0.9: configure only server-side values; never expose keys to a client.
MORI_BILLING_ENABLED=false
MORI_BILLING_TOSS_SECRET_KEY=
MORI_BILLING_TOSS_CLIENT_KEY=
MORI_BILLING_ENCRYPTION_KEY=
# MORI_BILLING_PRO_AMOUNT=SET_SERVER_PRICE
MORI_BILLING_SUCCESS_URL=
MORI_BILLING_FAIL_URL=
MORI_BILLING_LEASE_SECONDS=300
MORI_KIS_ENABLED=false
MORI_KIS_APP_KEY=
MORI_KIS_APP_SECRET=
MORI_KIS_SYMBOLS={"AAPL":"NAS"}
MORI_RUNTIME_PROVISIONING_ENABLED=false
MORI_RUNTIME_NAMESPACE=mori-agents
MORI_RUNTIME_IMAGE=
MORI_RUNTIME_MASTER_KEY=
MORI_RUNTIME_KUBERNETES_URL=https://kubernetes.default.svc
MORI_RUNTIME_KUBERNETES_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
MORI_RUNTIME_KUBERNETES_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
MORI_RUNTIME_STORAGE_CLASS=local-path
MORI_RUNTIME_STORAGE_SIZE=5Gi
MORI_RUNTIME_PROVIDER_SECRET=mori-hermes-provider
MORI_RUNTIME_SERVICE_ACCOUNT=mori-hermes
MORI_RUNTIME_IMAGE_PULL_SECRETS=[]
MORI_RUNTIME_LLM_URL=
MORI_RUNTIME_LLM_MODEL=
MORI_RUNTIME_LLM_CONTEXT_LENGTH=98304
MORI_RUNTIME_SEARXNG_URL=http://searxng.search.svc.cluster.local:8080
MORI_RUNTIME_NODE_SELECTOR={"kubernetes.io/arch":"amd64"}
MORI_RUNTIME_TOLERATIONS=[]
MORI_RUNTIME_POLL_SECONDS=10
MORI_RUNTIME_LEASE_SECONDS=180
MORI_RUNTIME_REQUEST_TIMEOUT_SECONDS=10
MORI_RUNTIME_SCALE_DOWN_DELAY_SECONDS=120
MORI_RUNTIME_INGRESS_CLASS=kourier.ingress.networking.knative.dev
MORI_SHARED_HERMES_ENABLED=false
MORI_SHARED_HERMES_BASE_URL=
MORI_SHARED_HERMES_API_KEY=
MORI_CHAT_WORKER_ENABLED=false
MORI_CHAT_JOB_LEASE_SECONDS=900
MORI_CHAT_JOB_MAX_ATTEMPTS=3
MORI_CHAT_POLL_SECONDS=1
MORI_CHAT_STREAM_SECONDS=25
MORI_AUTOMATION_PREWARM_SECONDS=120
MORI_DOCUMENTS_ENABLED=false
MORI_DOCUMENT_MAX_BYTES=10000000
MORI_DOCUMENT_USER_QUOTA_BYTES=100000000
MORI_DOCUMENT_FONT_PATH=/usr/share/fonts/truetype/nanum/NanumGothic.ttf
MORI_SPEECH_BASE_URL=
MORI_SPEECH_API_KEY=
MORI_SPEECH_MODEL=whisper-1
MORI_SPEECH_MAX_BYTES=10000000
MORI_NEWS_SUMMARY_ENABLED=false

# Deleted binary files remain restorable for this many days.
MORI_DOCUMENT_TRASH_DAYS=30
