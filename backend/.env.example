# Local development only. The production connection string belongs in a Secret.
MORI_DATABASE_URL=postgresql+psycopg://mori:mori-local-only@127.0.0.1:55432/mori
MORI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# The provider consoles must register the API callback URLs listed in docs/social-login.md.
MORI_AUTH_PUBLIC_BASE_URL=http://localhost:8000
MORI_AUTH_RETURN_URLS=["http://localhost:5173/auth/callback"]
# false is accepted only when the public API host is localhost/loopback.
MORI_AUTH_COOKIE_SECURE=false
MORI_AUTH_ACCESS_TOKEN_SECONDS=900
MORI_AUTH_SESSION_DAYS=30
MORI_NAVER_CLIENT_ID=
MORI_NAVER_CLIENT_SECRET=
MORI_KAKAO_CLIENT_ID=
MORI_KAKAO_CLIENT_SECRET=

# Hermes connection for authenticated chat. Shared home is single-owner only.
# Use an internal HTTP(S) origin without /v1; never expose the Hermes key to clients.
MORI_HERMES_BASE_URL=
MORI_HERMES_API_KEY=
# UUID from the test account's authenticated GET /v1/me response.
MORI_HERMES_TEST_USER_ID=
MORI_HERMES_TIMEOUT_SECONDS=300

# Authenticated conversations / SSE; see docs/chat.md. Shared home is single-owner only.
MORI_CHAT_ENABLED=false
MORI_HERMES_STARTUP_TIMEOUT_SECONDS=90
# JSON mapping user UUID -> {base_url, api_key}. Keep in server Secret, never Git.
# Private runtimes must already exist with separate homes/credentials; Pro users only.
MORI_CHAT_PRIVATE_RUNTIMES={}
